       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tini", "=", 
     RowBox[{"20", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tave", "=", 
     RowBox[{"1.5", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tfinal", "=", 
     RowBox[{"1", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"accval", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precval", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "function", " ", "solveDamping", " ", "receives", " ", "the", 
     " ", "same", " ", "arguments", " ", "as", " ", "solveFD"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Fig5aD", "=", 
