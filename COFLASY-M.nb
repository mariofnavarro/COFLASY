Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "This", " ", "benchmark", " ", "is", " ", "more", " ", "numerically", 
      " ", "challenging", " ", "and", " ", "the", " ", "solver", " ", "gets", 
      " ", "stuck", " ", "around", " ", "T"}], "=", 
     RowBox[{"2", "MeV"}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "but", " ", "fortunately", " ", "the", " ", "timeout", " ", "switches", 
      " ", "to", " ", "adiabatic", " ", "and", " ", "allows", " ", "to", " ", 
      "reach", " ", "Tave"}], "=", 
     RowBox[{"1.5", "MeV"}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Aval", "=", 
     SqrtBox["2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]val", "=", 
     RowBox[{"ArcTan", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
