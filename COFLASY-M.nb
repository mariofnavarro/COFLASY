   RowBox[{
    RowBox[{"\[Xi]\[Mu]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Mu]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Tau]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Tau]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tini", "=", 
     RowBox[{"20", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tave", "=", 
     RowBox[{"1.5", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tfinal", "=", 
