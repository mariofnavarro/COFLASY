Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Running", " ", "in", " ", "the", " ", "damping", " ", "approximation", 
    " ", "is", " ", "typically", " ", "much", " ", "faster"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Aval", "=", 
     SqrtBox["2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]val", "=", 
     FractionBox["\[Pi]", "2"]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]eini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]tile", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Mu]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Mu]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Tau]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Tau]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tini", "=", 
     RowBox[{"20", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tave", "=", 
     RowBox[{"1.5", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tfinal", "=", 
     RowBox[{"1", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"accval", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precval", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "function", " ", "solveDamping", " ", "receives", " ", "the", 
     " ", "same", " ", "arguments", " ", "as", " ", "solveFD"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Fig5bD", "=", 
    RowBox[{"solveDamping", "[", 
     RowBox[{
     "\[Xi]eini", ",", "\[Xi]\[Mu]ini", ",", "\[Xi]\[Tau]ini", ",", 
      "\"\<Fig5bD\>\"", ",", "Tini", ",", "Tave", ",", "Tfinal", ",", 
      "accval", ",", "precval"}], "]"}]}]}]}]], "Input",
