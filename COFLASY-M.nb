Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "provide", " ", "initial", " ", "conditions", " ", "over", " ", 
    
    RowBox[{"(", 
     RowBox[{"A", ",", "\[Phi]"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Aval", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]val", "=", 
     FractionBox["\[Pi]", "3"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"We", " ", "translate", " ", "from", " ", 
      RowBox[{"(", 
       RowBox[{"A", ",", "\[Phi]"}], ")"}], " ", "to", " ", 
      RowBox[{"(", 
       RowBox[{"\[Xi]e", ",", "\[Xi]\[Mu]", ",", "\[Xi]\[Tau]"}], ")"}]}], 
     ",", " ", 
     RowBox[{
     "alternatively", " ", "the", " ", "user", " ", "may", " ", "provide", 
      " ", "conditions", " ", "over", " ", 
      RowBox[{"(", 
       RowBox[{"\[Xi]e", ",", "\[Xi]\[Mu]", ",", "\[Xi]\[Tau]"}], ")"}], " ", 
      "directly"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]eini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]tile", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Mu]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Mu]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Tau]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Tau]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "This", " ", "is", " ", "the", " ", "minimum", " ", "input", " ", 
      "required", " ", "to", " ", "run", " ", "the", " ", "solving", " ", 
      "functions"}], ",", " ", 
     RowBox[{
     "with", " ", "all", " ", "the", " ", "optional", " ", "arguments", " ", 
      "using", " ", "default", " ", "values"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "run", " ", "the", " ", "system", " ", "with", " ", "FD", " ", 
     "collisions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Fig5aFD", "=", 
    RowBox[{"solveFD", "[", 
     RowBox[{"\[Xi]eini", ",", "\[Xi]\[Mu]ini", ",", "\[Xi]\[Tau]ini"}], 
     "]"}]}]}]}]], "Input",
