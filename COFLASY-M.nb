Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Running", " ", "in", " ", "the", " ", "damping", " ", "approximation", " ",
     "is", " ", "typically", " ", "much", " ", "faster"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Aval", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]val", "=", 
     FractionBox["\[Pi]", "3"]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]eini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
