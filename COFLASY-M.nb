Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Alternatively", ",", " ", 
    RowBox[{
    "the", " ", "user", " ", "can", " ", "define", " ", "all", " ", "the", 
     " ", "optional", " ", "arguments", " ", "to", " ", "be", " ", "used", 
     " ", "by", " ", "the", " ", "solving", " ", "functions"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "provide", " ", "initial", " ", "conditions", " ", "over", " ", 
    
    RowBox[{"(", 
     RowBox[{"A", ",", "\[Phi]"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Aval", "=", 
     SqrtBox["2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]val", "=", 
     FractionBox["\[Pi]", "2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]eini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]tile", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Mu]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Mu]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Tau]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Tau]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Name", " ", "for", " ", 
     RowBox[{"the", " ", ".", "dat"}], " ", "file", " ", "containing", " ", 
     "the", " ", "output"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"outputFilename", "=", "\"\<Fig5b\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"We", " ", "provide", " ", "initial", " ", "temperature", " ", 
      RowBox[{"(", "Tini", ")"}]}], ",", " ", 
     RowBox[{
     "temperature", " ", "at", " ", "which", " ", "oscillation", " ", 
      "average", " ", "is", " ", "taken", " ", 
      RowBox[{"(", "Tave", ")"}]}], ",", " ", 
     RowBox[{
     "and", " ", "we", " ", "extend", " ", "asymptotically", " ", "the", " ", 
      "result", " ", "at", " ", "Tave", " ", "until", " ", "a", " ", "final", 
      " ", "temperature", " ", 
      RowBox[{"(", "Tfinal", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Note", " ", "we", " ", "must", " ", "provide", " ", "Tini"}], 
     " ", "<", " ", "Tave", " ", "<=", " ", 
     RowBox[{"Tfinal", " ", "for", " ", "consistency"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tini", "=", 
     RowBox[{"20", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tave", "=", 
     RowBox[{"1.5", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tfinal", "=", 
     RowBox[{"1", "MeV"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "provide", " ", "accuracy", " ", "and", " ", "precision", " ", 
     "settings", " ", "for", " ", "NDSolve"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"accval", "=", "8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precval", "=", "8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "solving", " ", "method", " ", "used", " ", "by", " ", 
     "NDSolve", " ", "may", " ", "also", " ", "be", " ", "specified"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"method", "=", "\"\<BDF\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Adiabatic", "=", 
      RowBox[{
      "False", " ", "runs", " ", "the", " ", "full", " ", "system"}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{"while", " ", "Adiabatic"}], "=", 
      RowBox[{
       RowBox[{
       "True", " ", "runs", " ", "the", " ", "system", " ", "in", " ", "the", 
        " ", "adiabatic", " ", "approximationw", " ", "where", " ", "Vs"}], 
       "=", "0"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"adiabatic", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Execution", " ", "time", " ", "in", " ", "seconds", " ", "after", " ", 
      "which", " ", "the", " ", "solver", " ", "switches", " ", "to", " ", 
      "the", " ", "adiabatic", " ", "approximation"}], ",", " ", 
     RowBox[{
     "useful", " ", "for", " ", "numerically", " ", "challenging", " ", 
      "benchmarks"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timeoutAdiabatic", "=", "300"}], ";"}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Fig5bFD", "=", 
    RowBox[{"solveFD", "[", 
     RowBox[{
     "\[Xi]eini", ",", "\[Xi]\[Mu]ini", ",", "\[Xi]\[Tau]ini", ",", 
      "outputFilename", ",", "Tini", ",", "Tave", ",", "Tfinal", ",", 
      "accval", ",", "precval", ",", "method", ",", "adiabatic", ",", 
      "timeoutAdiabatic"}], "]"}]}]}]}]], "Input",
