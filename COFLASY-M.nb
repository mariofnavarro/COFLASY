Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Alternatively", ",", " ", 
    RowBox[{
    "the", " ", "user", " ", "can", " ", "define", " ", "all", " ", "the", " ",
      "optional", " ", "arguments", " ", "to", " ", "be", " ", "used", " ", 
     "by", " ", "the", " ", "solving", " ", "functions"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Aval", "=", 
     SqrtBox["2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]val", "=", 
     FractionBox["\[Pi]", "2"]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]eini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]tile", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Mu]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Mu]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]\[Tau]ini", "=", 
     RowBox[{"\[Xi]tildeto\[Xi]", "[", 
      RowBox[{"\[Xi]til\[Tau]", "[", 
       RowBox[{"Aval", ",", "\[Phi]val"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"As", " ", "optional", " ", "arguments"}], ",", " ", 
     RowBox[{"we", " ", "provide", " ", "a", " ", "name", " ", "for", " ", 
      RowBox[{"the", " ", ".", "dat"}], " ", "file", " ", "containing", " ", 
      "the", " ", "output", " ", 
      RowBox[{"(", "filename", ")"}]}], ",", " ", 
     RowBox[{"initial", " ", "temperature", " ", 
      RowBox[{"(", "Tini", ")"}]}], ",", " ", 
     RowBox[{
     "temperature", " ", "at", " ", "which", " ", "oscillation", " ", 
      "average", " ", "is", " ", "taken", " ", 
      RowBox[{"(", "Tave", ")"}]}], ",", " ", 
     RowBox[{
     "and", " ", "we", " ", "extend", " ", "asymptotically", " ", "the", " ", 
      "result", " ", "at", " ", "Tave", " ", "until", " ", "a", " ", "final", 
      " ", "temperature", " ", 
      RowBox[{
       RowBox[{"(", "Tfinal", ")"}], "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Note", " ", "we", " ", "must", " ", "provide", " ", "Tini"}], 
     " ", "<", " ", "Tave", " ", "<=", " ", 
     RowBox[{"Tfinal", " ", "for", " ", 
      RowBox[{"consistency", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"We", " ", "also", " ", "provide", " ", "accuracy", " ", 
     RowBox[{"(", "accval", ")"}], " ", "and", " ", "precision", " ", 
     RowBox[{"(", "precval", ")"}], " ", "settings", " ", "for", " ", 
     RowBox[{"NDSolve", ".", " ", "The"}], " ", "solving", " ", "method", " ", 
     RowBox[{"(", "solverMethod", ")"}], " ", "used", " ", "by", " ", 
     "NDSolve", " ", "may", " ", "also", " ", "be", " ", 
     RowBox[{"specified", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"adiabatic", "->", 
      RowBox[{
      "False", " ", "runs", " ", "the", " ", "full", " ", "system"}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"while", " ", "adiabatic"}], "->", 
       RowBox[{
       "True", " ", "runs", " ", "the", " ", "system", " ", "in", " ", "the", 
        " ", "adiabatic", " ", "approximationw", " ", "where", " ", "Vs"}]}], 
      "=", 
      RowBox[{"0.", " ", "Finally"}]}], ",", 
     RowBox[{
     "timeoutAdiabatic", " ", "is", " ", "the", " ", "execution", " ", "time",
       " ", "in", " ", "seconds", " ", "after", " ", "which", " ", "the", " ",
       "solver", " ", "switches", " ", "to", " ", "the", " ", "adiabatic", " ",
       "approximation"}], ",", " ", 
     RowBox[{"useful", " ", "for", " ", "numerically", " ", "challenging", " ", 
      RowBox[{"benchmarks", "."}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Fig5bFD", "=", 
    RowBox[{"solveFD", "[", 
     RowBox[{"\[Xi]eini", ",", "\[Xi]\[Mu]ini", ",", "\[Xi]\[Tau]ini", ",", 
      RowBox[{"filename", "->", "\"\<Fig5b\>\""}], ",", 
      RowBox[{"Tini", "->", 
       RowBox[{"20", "MeV"}]}], ",", 
      RowBox[{"Tave", "->", 
       RowBox[{"1.5", "MeV"}]}], ",", 
      RowBox[{"Tfinal", "->", 
