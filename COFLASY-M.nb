   RowBox[{
    RowBox[{"accval", "=", "7"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"In", " ", "some", " ", "cases"}], ",", " ", 
     RowBox[{
     "it", " ", "may", " ", "be", " ", "reasonable", " ", "to", " ", "reduce",
       " ", "accuracy", " ", "and", " ", "precision", " ", "to", " ", "6", 
      " ", "or", " ", "7", " ", "to", " ", "help", " ", "with", " ", "the", 
      " ", "numerics"}]}], "*)"}], "\[IndentingNewLine]", 
