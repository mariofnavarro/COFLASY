Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"This", " ", "is", "  ", 
     RowBox[{"Eq", ".", " ", 
      RowBox[{"(", "32", ")"}]}], " ", "of", " ", "the", " ", "paper"}], ",", 
    " ", 
    RowBox[{
    "which", " ", "can", " ", "be", " ", "used", " ", "to", " ", "decompose", 
     " ", "a", " ", "general", " ", "3", "x3", " ", "complex", " ", "matrix", 
     " ", "into", " ", "its", " ", "components", " ", "in", " ", "the", " ", 
     "basis", " ", 
     RowBox[{"(", 
      RowBox[{"Identity", ",", " ", 
       RowBox[{"Gell", "-", "Mann"}]}], ")"}]}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"gellMannComponents", "[", "X_", "]"}], ":=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "3"}], 
         RowBox[{"Tr", "[", "X", "]"}]}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", "2"}], 
           RowBox[{"Tr", "[", 
            RowBox[{"X", ".", 
             RowBox[{"GellMannMatrices", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "8"}], "}"}]}], "]"}]}], "}"}], 
      "]"}]}], ";"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"However", ",", " ", 
    RowBox[{
    "we", " ", "can", " ", "also", " ", "use", " ", "the", " ", "following", 
     " ", "function", " ", "for", " ", "the", " ", "decomposition"}]}], 
   "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gellMannExpansion", "[", 
      RowBox[{
      "a0_", ",", "a1_", ",", "a2_", ",", "a3_", ",", "a4_", ",", "a5_", ",", 
       "a6_", ",", "a7_", ",", "a8_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"a0", "*", "unitmat"}], "+", 
      RowBox[{"a1", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "+", 
      RowBox[{"a2", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "+", 
      RowBox[{"a3", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "+", 
      RowBox[{"a4", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], "+", 
      RowBox[{"a5", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "5", "]"}], "]"}]}], "+", 
      RowBox[{"a6", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "6", "]"}], "]"}]}], "+", 
      RowBox[{"a7", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "7", "]"}], "]"}]}], "+", 
      RowBox[{"a8", "*", 
       RowBox[{"gellMannMatrices", "[", 
        RowBox[{"[", "8", "]"}], "]"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gellMannComponents", "[", "X_", "]"}], ":=", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gellMannExpansion", "[", 
           RowBox[{
           "a0", ",", "a1", ",", "a2", ",", "a3", ",", "a4", ",", "a5", ",", 
            "a6", ",", "a7", ",", "a8"}], "]"}], "==", "X"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "a0", ",", "a1", ",", "a2", ",", "a3", ",", "a4", ",", "a5", ",", 
           "a6", ",", "a7", ",", "a8"}], "}"}]}], "]"}], "]"}], "//", 
      "First"}]}], ";"}], " ", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "We", " ", "find", " ", "the", " ", "function", " ", "above", " ", "to", 
      " ", "deliver", " ", "the", " ", "same", " ", "analytical", " ", 
      "results", " ", "for", " ", "the", " ", "decomposition", " ", "of", " ",
       "all", " ", "matrices", " ", "except", " ", "for", " ", "the", " ", 
      "a0", " ", "component", " ", "of", " ", "the", " ", "FD", " ", 
      "collision", " ", "terms"}], ",", "\n", " ", 
     RowBox[{
     "where", " ", "we", " ", "find", " ", "the", " ", "two", " ", 
      "functions", " ", "to", " ", "deliver", " ", "potentially", " ", 
      "different", " ", "analytical", " ", "functions", " ", "which", " ", 
      "nevertheless", " ", "agree", " ", "numerically", " ", "extremely", " ",
       "well"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"with", " ", "relative", " ", "differences"}], " ", "<", " ", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}], "%", " ", "in", " ", "all", " ", "cases", " ", 
       "when", " ", "evaluating", " ", "both", " ", "functions", " ", "with", 
       " ", "200", " ", "random", " ", "density", " ", 
       RowBox[{"matrices", ".", "\n", " ", "However"}]}]}], ",", " ", 
     RowBox[{
     "the", " ", "function", " ", "above", " ", "seems", " ", "to", " ", 
      "deliver", " ", "a", " ", "more", " ", "compact", " ", "decomposition", 
      " ", "of", " ", "the", " ", "collision", " ", "terms", " ", "that", " ",
       "is", " ", "better", " ", "handled", " ", "by", " ", "Mathematica"}], 
     ",", "\n", " ", 
     RowBox[{
     "leading", " ", "to", " ", "a", " ", "factor", " ", "2", " ", "faster", 
      " ", "evolution", " ", "times", " ", "in", " ", "NDSolve", " ", "with", 
      " ", "respect", " ", "to", " ", "using", " ", 
      RowBox[{"Eq", ".", " ", 
       RowBox[{"(", "32", ")"}]}], " ", "of", " ", "the", " ", "paper", " ", 
      "for", " ", "the", " ", "decomposition"}]}], "*)"}]}]}]], "Code",Express\
ionUUID->"a183e5d0-3940-49fd-968d-d511bd60dae7"]
