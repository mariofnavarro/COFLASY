           RowBox[{"Length", "[", "Tvec", "]"}], "+", "2"}], ",", "2"}], 
         "]"}], "]"}], "=", "\[CapitalDelta]nefinal"}], ";", "\n", 
      RowBox[{
       RowBox[{"Matvec", "[", 
        RowBox[{"[", 
