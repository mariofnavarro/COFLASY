      "\n", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", "\n", 
      RowBox[{"Tvec", "=", 
       RowBox[{"Reverse", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"10", "^", "i"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Log10", "[", "Taveval", "]"}], ",", 
            RowBox[{"Log10", "[", "Tinival", "]"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Log10", "[", "Tinival", "]"}], "-", 
