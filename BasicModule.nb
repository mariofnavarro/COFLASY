Cell["Basic module of COFLASY-M", "Section",ExpressionUUID->"8750b8bd-e88d-4348-9f44-8d371e419677"],

Cell[TextData[{
 "by Valerie Domcke (valerie.domcke@cern.ch), Miguel Escudero \
(miguel.escudero@cern.ch), Mario Fernandez Navarro \
(Mario.FernandezNavarro@glasgow.ac.uk), Stefan Sandner \
(stefan.sandner@lanl.gov)\n\nIf you use this code for scientific \
publications, please cite the paper :\n  \n\"Lepton Flavour Asymmetries: from \
the early Universe to BBN\",  Valerie Domcke, Miguel Escudero, Mario \
Fernandez Navarro and Stefan Sandner,\n[JHEP 06, 137] ( \
https://link.springer.com/article/10.1007/JHEP06(2025)137 ), \
[arXiv:2502.14960] ( https://arxiv.org/abs/2502.14960 ), [INSPIRE] ( \
https://inspirehep.net/literature/2893306 ) .\n\n",
 StyleBox["\[OpenCurlyDoubleQuote]A Limit on the Total Lepton Number in the \
Universe from BBN and the CMB.\[CloseCurlyDoubleQuote] Valerie Domcke, Miguel \
Escudero, Mario Fernandez Navarro and Stefan Sandner, [arxiv:2510.02438]. \
(https://arxiv.org/abs/2510.02438).", "Subsection",
  FontSize->16,
  FontColor->RGBColor[
   0.04122987716487373, 0.03126573586633097, 0.015243762874799725`]],
 "\n  "
}], "Text",
 CellChangeTimes->{{3.968830038415091*^9, 
  3.96883004334846*^9}},ExpressionUUID->"c4bfa837-9038-45bf-b7ad-\
689541e6744b"],

Cell["\<\
This module contains all the definitions, constants and functions to solve \
the system of ODEs.

All equation numbering in this module refers to the technical notes in pdf \
accompanying this code, unless otherwise specified.

Last major update: 09-07-2025
v1.2\
\>", "Text",ExpressionUUID->"1e59a244-daa4-4037-a52c-ced80b582c56"],

