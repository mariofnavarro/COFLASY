Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Useful", " ", "equations", " ", "to", " ", "connect", " ", 
     RowBox[{"(", 
      RowBox[{"A", ",", "\[Phi]"}], ")"}], " ", "to", " ", "\[Xi]t"}], "=", 
    RowBox[{"\[Xi]", "+", 
     RowBox[{
      RowBox[{"\[Xi]", "^", "3"}], "/", 
      RowBox[{"\[Pi]", "^", "2"}]}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Eq", ".", " ", 
    RowBox[{"(", "20", ")"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]tile", "[", 
      RowBox[{"A_", ",", "\[Phi]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", "->", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "1"}], "]"}]}], 
       "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]til\[Mu]", "[", 
      RowBox[{"A_", ",", "\[Phi]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", "->", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "1"}], "]"}]}], 
       "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]til\[Tau]", "[", 
      RowBox[{"A_", ",", "\[Phi]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", "->", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "1"}], "]"}]}], 
       "}"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"\[Xi]t", "==", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{
            RowBox[{"\[Xi]", "^", "3"}], "/", 
            RowBox[{"\[Pi]", "^", "2"}]}]}]}], ",", "\[Xi]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "//", "ToRadicals"}], "//", 
     "Simplify"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Inverting", " ", 
     RowBox[{"Eq", ".", " ", 
      RowBox[{"(", "22", ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]tildeto\[Xi]", "[", "\[Xi]t_", "]"}], ":=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Pi]", "/", "6"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"2", "/", "3"}], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"3", "^", 
             RowBox[{"(", 
              RowBox[{"1", "/", "3"}], ")"}]}], " ", 
            RowBox[{"\[Pi]", "^", 
             RowBox[{"(", 
              RowBox[{"2", "/", "3"}], ")"}]}]}], "-", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"1", "/", "3"}], ")"}]}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "9"}], " ", "\[Xi]t"}], "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"12", " ", 
                  RowBox[{"\[Pi]", "^", "2"}]}], "+", 
                 RowBox[{"81", " ", 
                  RowBox[{"\[Xi]t", "^", "2"}]}]}], "]"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"2", "/", "3"}], ")"}]}]}]}], ")"}]}], ")"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "9"}], " ", "\[Xi]t"}], "+", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"12", " ", 
             RowBox[{"\[Pi]", "^", "2"}]}], "+", 
            RowBox[{"81", " ", 
             RowBox[{"\[Xi]t", "^", "2"}]}]}], "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
   "\n"}]}]], "Code",ExpressionUUID->"19970fb0-6a01-4277-8209-8bc8ca62a7fc"],

