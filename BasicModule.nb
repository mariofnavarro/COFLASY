          RowBox[{"Tref", "/", "T"}]}], "}"}]}], "/.", "sol"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"\[CapitalDelta]n\[Mu]", "[", "T_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"FAC\[CapitalDelta]n", " ", 
          RowBox[{"3", "/", "4"}], " ", 
          RowBox[{
           RowBox[{"Zeta", "[", "3", "]"}], "/", 
           RowBox[{"\[Pi]", "^", "2"}]}], " ", 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"rmat", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
            RowBox[{"rbarmat", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}]}], "/.", 
         "rtorx"}], "/.", 
        RowBox[{"{", 
         RowBox[{"x", "->", 
          RowBox[{"Tref", "/", "T"}]}], "}"}]}], "/.", "sol"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"\[CapitalDelta]n\[Tau]", "[", "T_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"FAC\[CapitalDelta]n", " ", 
          RowBox[{"3", "/", "4"}], " ", 
          RowBox[{
           RowBox[{"Zeta", "[", "3", "]"}], "/", 
           RowBox[{"\[Pi]", "^", "2"}]}], " ", 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"rmat", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "3"}], "]"}], "]"}], "-", 
            RowBox[{"rbarmat", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "3"}], "]"}], "]"}]}], "]"}]}], "/.", 
         "rtorx"}], "/.", 
        RowBox[{"{", 
         RowBox[{"x", "->", 
          RowBox[{"Tref", "/", "T"}]}], "}"}]}], "/.", "sol"}]}], ";", "\n", 
     "\n", 
     RowBox[{"(*", 
      RowBox[{"Oscillation", " ", "average"}], "*)"}], "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "First", " ", "I", " ", "store", " ", "the", " ", "density", " ", 
       "matrix", " ", "at", " ", "Tave"}], "*)"}], "\n", "\n", 
     RowBox[{"rTave", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"rmat", "/.", "rtorx"}], "/.", "sol"}], "/.", 
       RowBox[{"x", "->", 
        RowBox[{"Tref", "/", "Taveval"}]}]}]}], ";", "\n", 
     RowBox[{"rbarTave", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"rbarmat", "/.", "rtorx"}], "/.", "sol"}], "/.", 
       RowBox[{"x", "->", 
        RowBox[{"Tref", "/", "Taveval"}]}]}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"Then", " ", "I", " ", "apply", " ", 
       RowBox[{"Eq", ".", " ", 
        RowBox[{"(", "21", ")"}]}], " ", "to", " ", "extract", " ", "the", 
       " ", "asymptotic", " ", "final", " ", "asymetries"}], "*)"}], "\n", 
     "\n", 
     RowBox[{"rFinal", "=", 
      RowBox[{"uUnitary", " ", ".", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Diagonal", "[", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "uUnitary", "]"}], " ", ".", " ",
           "rTave", " ", ".", " ", "uUnitary"}], "]"}], "]"}], " ", ".", " ", 
       
       RowBox[{"ConjugateTranspose", "[", "uUnitary", "]"}]}]}], ";", "\n", 
     RowBox[{"rbarFinal", "=", 
      RowBox[{"uUnitary", " ", ".", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Diagonal", "[", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "uUnitary", "]"}], " ", ".", " ",
           "rbarTave", " ", ".", " ", "uUnitary"}], "]"}], "]"}], " ", ".", 
       " ", 
       RowBox[{"ConjugateTranspose", "[", "uUnitary", "]"}]}]}], ";", "\n", 
     "\n", 
     RowBox[{"\[CapitalDelta]nefinal", "=", 
      RowBox[{"FAC\[CapitalDelta]n", " ", 
       RowBox[{"3", "/", "4"}], " ", 
       RowBox[{
        RowBox[{"Zeta", "[", "3", "]"}], "/", 
        RowBox[{"\[Pi]", "^", "2"}]}], " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"rFinal", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
         RowBox[{"rbarFinal", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], ";", "\n", 
     RowBox[{"\[CapitalDelta]n\[Mu]final", "=", 
      RowBox[{"FAC\[CapitalDelta]n", " ", 
       RowBox[{"3", "/", "4"}], " ", 
       RowBox[{
        RowBox[{"Zeta", "[", "3", "]"}], "/", 
        RowBox[{"\[Pi]", "^", "2"}]}], " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"rFinal", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
         RowBox[{"rbarFinal", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}]}]}], ";", "\n", 
     RowBox[{"\[CapitalDelta]n\[Tau]final", "=", 
      RowBox[{"FAC\[CapitalDelta]n", " ", 
       RowBox[{"3", "/", "4"}], " ", 
       RowBox[{
        RowBox[{"Zeta", "[", "3", "]"}], "/", 
        RowBox[{"\[Pi]", "^", "2"}]}], " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"rFinal", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "3"}], "]"}], "]"}], "-", 
         RowBox[{"rbarFinal", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "3"}], "]"}], "]"}]}], "]"}]}]}], ";", "\n", 
     "\n", 
     RowBox[{"(*", 
      RowBox[{"Inverting", " ", 
       RowBox[{"Eq", ".", " ", 
        RowBox[{"(", "22", ")"}]}]}], "*)"}], "\n", 
     RowBox[{"\[Xi]\[Alpha]final", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Xi]tildeto\[Xi]", "[", 
         RowBox[{"6", "\[CapitalDelta]nefinal"}], "]"}], ",", 
        RowBox[{"\[Xi]tildeto\[Xi]", "[", 
         RowBox[{"6", "\[CapitalDelta]n\[Mu]final"}], "]"}], ",", 
        RowBox[{"\[Xi]tildeto\[Xi]", "[", 
         RowBox[{"6", "\[CapitalDelta]n\[Tau]final"}], "]"}]}], "}"}]}], ";", 
     "\n", 
     RowBox[{"\[Xi]efinal", "=", 
      RowBox[{"\[Xi]\[Alpha]final", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"Relevant", " ", "output"}], "*)"}], "\n", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Final \[Xi]e: \>\"", ",", "\[Xi]efinal"}], "]"}], ";", 
     "\n", "\n", 
     RowBox[{"(*", " ", "Plot", " ", "*)"}], "\n", "\n", 
     RowBox[{"plotBeforeTave", "=", 
      RowBox[{"LogLinearPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalDelta]n\[Tau]", "[", "T", "]"}], ",", 
          RowBox[{"\[CapitalDelta]n\[Mu]", "[", "T", "]"}], ",", 
          RowBox[{"\[CapitalDelta]ne", "[", "T", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", "Tinival", ",", "Taveval"}], "}"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", "\n", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<T [MeV]\>\"", ",", 
             RowBox[{"FontSize", "->", "20"}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<\\!\\(\\*FractionBox[SubscriptBox[\\((n - \
\\*OverscriptBox[\\(n\\), \\(_\\)])\\), \\(\[Alpha]\[Alpha]\\)], \
SuperscriptBox[\\(T\\), \\(3\\)]]\\)\>\"", ",", 
             RowBox[{"FontSize", "->", "30"}]}], "]"}]}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Darker", "@", "Blue"}], ",", 
             RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Darker", "@", "Red"}], ",", 
             RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Black", ",", 
             RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], "}"}]}], 
        ",", 
        RowBox[{"ScalingFunctions", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Reverse\>\"", ",", "Identity"}], "}"}]}], ",", 
        RowBox[{"BaseStyle", "->", "Times"}], ",", 
        RowBox[{"FrameStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", 
        RowBox[{"RotateLabel", "->", "False"}], ",", 
        RowBox[{"ImageSize", "->", "575"}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"{", 
          RowBox[{"FontSize", "->", "20"}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"SwatchLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Black", ",", 
              RowBox[{"Darker", "@", "Red"}], ",", 
              RowBox[{"Darker", "@", "Blue"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
             "\"\<e\>\"", ",", "\"\<\[Mu]\>\"", ",", "\"\<\[Tau]\>\""}], 
             "}"}], ",", 
            RowBox[{"LegendLayout", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<Column\>\"", ",", "1"}], "}"}]}], ",", 
            RowBox[{"LegendMarkers", "->", 
             RowBox[{"{", "\"\<Line\>\"", "}"}]}], ",", 
            RowBox[{"LegendMarkerSize", "->", "25"}]}], "]"}], "}"}]}]}], 
       "]"}]}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Taveval", "==", "Tfinalval"}], ",", 
       RowBox[{"plotFinal", "=", "plotBeforeTave"}], ",", 
       RowBox[{
        RowBox[{"plotAfterTave", "=", 
         RowBox[{"LogLinearPlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "\[CapitalDelta]n\[Tau]final", ",", "\[CapitalDelta]n\[Mu]final", 
             ",", "\[CapitalDelta]nefinal"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"T", ",", "Taveval", ",", "Tfinalval"}], "}"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", "\n", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<T [MeV]\>\"", ",", 
                RowBox[{"FontSize", "->", "20"}]}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<\\!\\(\\*FractionBox[SubscriptBox[\\((n - \
\\*OverscriptBox[\\(n\\), \\(_\\)])\\), \\(\[Alpha]\[Alpha]\\)], \
SuperscriptBox[\\(T\\), \\(3\\)]]\\)\>\"", ",", 
                RowBox[{"FontSize", "->", "30"}]}], "]"}]}], "}"}]}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Darker", "@", "Blue"}], ",", 
                RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Darker", "@", "Red"}], ",", 
                RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"Black", ",", 
                RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], "}"}]}], 
           ",", 
           RowBox[{"ScalingFunctions", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Reverse\>\"", ",", "Identity"}], "}"}]}], ",", 
           RowBox[{"BaseStyle", "->", "Times"}], ",", 
           RowBox[{"FrameStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", 
           RowBox[{"RotateLabel", "->", "False"}], ",", 
           RowBox[{"ImageSize", "->", "575"}], ",", 
           RowBox[{"LabelStyle", "->", 
            RowBox[{"{", 
             RowBox[{"FontSize", "->", "20"}], "}"}]}]}], "]"}]}], ";", 
        RowBox[{"plotFinal", "=", 
         RowBox[{"Show", "[", 
          RowBox[{"plotBeforeTave", ",", "plotAfterTave", ",", 
           RowBox[{"PlotRange", "->", "Full"}]}], "]"}]}], ";"}]}], "]"}], 
     ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"Export", " ", "results", " ", "to", " ", 
       RowBox[{"output", " ", ".", "dat"}], " ", "file"}], "*)"}], "\n", "\n", 
     RowBox[{"SetDirectory", "[", 
      RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", "\n", 
     RowBox[{"Tvec", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"10", "^", "i"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Log10", "[", "Taveval", "]"}], ",", 
           RowBox[{"Log10", "[", "Tinival", "]"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Log10", "[", "Tinival", "]"}], "-", 
              RowBox[{"Log10", "[", "Taveval", "]"}]}], ")"}], "/", 
            "1000"}]}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Matvec", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "Tvec", "]"}], "+", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Matvec", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], "=", 
         RowBox[{"Tvec", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", 
        RowBox[{
         RowBox[{"Matvec", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}], "=", 
         RowBox[{"\[CapitalDelta]ne", "[", 
          RowBox[{"Tvec", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", "\n", 
        RowBox[{
         RowBox[{"Matvec", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}], "=", 
         RowBox[{"\[CapitalDelta]n\[Mu]", "[", 
          RowBox[{"Tvec", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", "\n", 
        RowBox[{
         RowBox[{"Matvec", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "4"}], "]"}], "]"}], "=", 
         RowBox[{"\[CapitalDelta]n\[Tau]", "[", 
          RowBox[{"Tvec", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";"}], "\n", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "Tvec", "]"}], ",", "1"}], "}"}]}], "]"}], 
     ";", "\n", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "1"}], ",", "1"}], "]"}],
        "]"}], "=", "Taveval"}], ";", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "1"}], ",", "2"}], "]"}],
        "]"}], "=", "\[CapitalDelta]nefinal"}], ";", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "1"}], ",", "3"}], "]"}],
        "]"}], "=", "\[CapitalDelta]n\[Mu]final"}], ";", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "1"}], ",", "4"}], "]"}],
        "]"}], "=", "\[CapitalDelta]n\[Tau]final"}], ";", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "2"}], ",", "1"}], "]"}],
        "]"}], "=", "Tfinalval"}], ";", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "2"}], ",", "2"}], "]"}],
        "]"}], "=", "\[CapitalDelta]nefinal"}], ";", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "2"}], ",", "3"}], "]"}],
        "]"}], "=", "\[CapitalDelta]n\[Mu]final"}], ";", "\n", 
     RowBox[{
      RowBox[{"Matvec", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "Tvec", "]"}], "+", "2"}], ",", "4"}], "]"}],
        "]"}], "=", "\[CapitalDelta]n\[Tau]final"}], ";", "\n", "\n", 
     RowBox[{"Matvec", "=", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{"Matvec", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "All"}], "]"}], "]"}], ",", "7"}], "]"}]}], ";",
      "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Thermodynamics are output to: output/\>\"", "<>", " ", 
       RowBox[{"OptionValue", "[", "filename", "]"}], "<>", "\"\<.dat\>\""}], 
      "]"}], ";", "\n", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"\"\<output/\>\"", "<>", " ", 
        RowBox[{"OptionValue", "[", "filename", "]"}], "<>", "\"\<.dat\>\""}],
        ",", "Matvec", ",", "\"\<Table\>\"", ",", 
       RowBox[{"\"\<FieldSeparators\>\"", "->", "\"\<      \>\""}], ",", 
       RowBox[{"\"\<TableHeadings\>\"", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "\"\<# T[MeV]\>\"", " ", ",", "\"\<nnbare\>\"", ",", 
          "\"\<nnbarmu\>\"", ",", "\"\<nnbartau\>\""}], "}"}]}]}], "]"}], ";",
      "\n", "\n", "\n", 
     RowBox[{"tfinal", "=", 
      RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total execution time: \>\"", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tfinal", "-", "tini"}], "<", "60"}], ",", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"tfinal", "-", "tini"}], ",", "4"}], "]"}], "\"\<s\>\""}],
          ",", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"tfinal", "-", "tini"}], ")"}], "/", "60"}], ",", "4"}],
            "]"}], "\"\<min\>\""}]}], "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Return", "[", "plotFinal", "]"}], ";"}], "\n", ")"}]}], 
  ";"}]], "Code",ExpressionUUID->"d8546012-4f6a-4040-92a9-917a12e66715"]
